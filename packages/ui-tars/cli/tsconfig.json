{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@ui-tars/operator-adb": ["../operators/adb/src/index.ts"],
      "@ui-tars/operator-nut-js": ["../operators/nut-js/src/index.ts"],
      "@ui-tars/sdk": ["../sdk/src/index.ts"],
      "@ui-tars/sdk/core": ["../sdk/src/core.ts"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
